{
  "$defs": {
    "CandidateModeSelectionV1": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "mode_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Mode Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "mode_id"
      ],
      "title": "CandidateModeSelectionV1",
      "type": "object"
    },
    "ModelCapability": {
      "enum": [
        "chat",
        "embeddings",
        "recommendation_verifier"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "SourceProvider": {
      "enum": [
        "slack",
        "notion",
        "confluence",
        "google_drive",
        "sharepoint"
      ],
      "title": "SourceProvider",
      "type": "string"
    },
    "SourceSelectionV1": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/SourceTransportMode"
        },
        "provider": {
          "$ref": "#/$defs/SourceProvider"
        }
      },
      "required": [
        "provider",
        "mode"
      ],
      "title": "SourceSelectionV1",
      "type": "object"
    },
    "SourceTransportMode": {
      "enum": [
        "export_archive",
        "live_mcp_oauth",
        "oauth_3lo_rest",
        "oauth_rest",
        "graph_oauth_preview"
      ],
      "title": "SourceTransportMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_micro_usd": {
      "minimum": 0,
      "title": "Budget Micro Usd",
      "type": "integer"
    },
    "candidate_modes": {
      "items": {
        "$ref": "#/$defs/CandidateModeSelectionV1"
      },
      "minItems": 1,
      "title": "Candidate Modes",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "include_dms": {
      "const": false,
      "default": false,
      "title": "Include Dms",
      "type": "boolean"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Key Id",
      "type": "string"
    },
    "max_questions": {
      "minimum": 1,
      "title": "Max Questions",
      "type": "integer"
    },
    "nonce": {
      "maxLength": 512,
      "minLength": 8,
      "title": "Nonce",
      "type": "string"
    },
    "projection_schema_version": {
      "const": 1,
      "default": 1,
      "title": "Projection Schema Version",
      "type": "integer"
    },
    "registry_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Snapshot Hash",
      "type": "string"
    },
    "required_model_capabilities": {
      "items": {
        "$ref": "#/$defs/ModelCapability"
      },
      "title": "Required Model Capabilities",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "runner_id": {
      "format": "uuid",
      "title": "Runner Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signature": {
      "maxLength": 512,
      "minLength": 8,
      "title": "Signature",
      "type": "string"
    },
    "source_selections": {
      "items": {
        "$ref": "#/$defs/SourceSelectionV1"
      },
      "minItems": 1,
      "title": "Source Selections",
      "type": "array"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "workspace_id",
    "runner_id",
    "issued_at",
    "expires_at",
    "nonce",
    "source_selections",
    "candidate_modes",
    "required_model_capabilities",
    "budget_micro_usd",
    "max_questions",
    "registry_snapshot_hash",
    "key_id",
    "signature"
  ],
  "title": "JobSpecV1",
  "type": "object"
}
