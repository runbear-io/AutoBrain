{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobrain.run/schemas/fixture-v1.json",
  "title": "AutoBrain fixture v1",
  "description": "Secret-free, data-only local benchmark fixture. Faults are declarative metadata and are never executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_sha256", "documents", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/document"}},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/candidate", "properties": {"id": {"const": "llm-wiki"}}},
        {"$ref": "#/$defs/candidate", "properties": {"id": {"const": "mem0"}}},
        {"$ref": "#/$defs/candidate", "properties": {"id": {"const": "gbrain"}}}
      ],
      "items": false
    },
    "faults": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fault"}}
  },
  "$defs": {
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "source_id", "source_kind", "canonical_url", "title", "text", "question", "content_hash"],
      "properties": {
        "provider": {"enum": ["slack", "notion"]},
        "source_id": {"type": "string", "pattern": "^(slack|notion):[A-Za-z0-9:_-]+$"},
        "source_kind": {"enum": ["SLACK_MESSAGE", "NOTION_PAGE"]},
        "canonical_url": {"type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 4096},
        "text": {"type": "string", "maxLength": 1000000},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "score", "cost_usd"],
      "properties": {
        "id": {"enum": ["llm-wiki", "mem0", "gbrain"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["content_hash_mismatch", "duplicate_source_id", "missing_document", "secret_like_content", "unsafe_url"]},
        "target": {"type": "string", "minLength": 1, "maxLength": 512},
        "detail": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
